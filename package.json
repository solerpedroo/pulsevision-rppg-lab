{
  "name": "pulsevision",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "build": "npm run build -w apps/web",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "contracts": "json2ts -i 'packages/rppg_types/schemas/*.json' -o packages/rppg_types/generated/",
    "test:e2e": "npm run test:e2e -w apps/web"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "json-schema-to-typescript": "^15.0.0"
  }
}
